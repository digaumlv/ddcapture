# Template. Copie para .env e preencha - o .env nao vai para o versionamento.
# NAO coloque chaves reais neste arquivo: ele e versionado.

# Chave de API (Organization Settings > API Keys)
DD_API_KEY=

# Chave de aplicacao (Organization Settings > Application Keys)
# Precisa do escopo dashboards_read; para logs/SLO adicione os escopos correspondentes.
DD_APP_KEY=

# Site do Datadog. Um de:
#   datadoghq.com | datadoghq.eu | us3.datadoghq.com | us5.datadoghq.com
#   ap1.datadoghq.com | ap2.datadoghq.com | ddog-gov.com
DD_SITE=datadoghq.com


# =====================================================================
# Banco das tabelas de preco (modulo precificacao)
# =====================================================================
# Prefixo PRECOS_ para nao colidir com as variaveis do coletor acima.

# sqlite | postgres | mysql
PRECOS_DB_ENGINE=sqlite

# sqlite : caminho do arquivo, relativo a raiz do projeto
# demais : nome do banco
PRECOS_DB_NAME=precos.sqlite

# So para postgres e mysql. Em sqlite ficam vazios.
PRECOS_DB_HOST=
PRECOS_DB_PORT=
PRECOS_DB_USER=
PRECOS_DB_PASSWORD=
